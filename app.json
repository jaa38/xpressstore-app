{
  "expo": {
    "name": "XpressStore",
    "slug": "xpressstore-app",
    "version": "1.0.0",
    "scheme": "xpressstore",
    "orientation": "portrait",
    "icon": "./assets/appIcon/appIcon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xpressstore.app"
    },
    "android": {
      "package": "com.xpressstore.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/appIcon/appIcon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ddc17d2-50ba-4a8e-968b-0a0ab32efb65"
      }
    }
  }
}
